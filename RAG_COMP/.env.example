# Groq API key (required for chat generation).
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# Primary and fallback Groq models.
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_FALLBACK_MODELS="llama-3.1-8b-instant,llama3-70b-8192,mixtral-8x7b-32768"

# Optional overrides.
GROQ_BASE_URL="https://api.groq.com/openai/v1"
CHUB_GITHUB_REPO="andrewng/chub"
GITHUB_TOKEN=""

# Optional app URL.
APP_URL="http://localhost:3000"
