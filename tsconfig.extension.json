{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "outDir": "out",
    "rootDir": ".",
    "noEmit": false,
    "isolatedModules": false,
    "allowImportingTsExtensions": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["extension-template.ts", "vscode-shim.d.ts"]
}
