{
  "name": "autochub-context-hub",
  "version": "1.0.0",
  "description": "Lightweight, offline-first CLI to detect and fix deprecated API calls using in-memory graph analysis and Andrew Ng's Context Hub.",
  "author": "Auto-CHUB Team",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/amanpandadev-dev/autochub-context-hub.git"
  },
  "bugs": {
    "url": "https://github.com/amanpandadev-dev/autochub-context-hub/issues"
  },
  "homepage": "https://github.com/amanpandadev-dev/autochub-context-hub#readme",
  "keywords": [
    "deprecated-api",
    "code-analysis",
    "graphology",
    "cli",
    "refactoring",
    "migration",
    "typescript",
    "javascript",
    "context-hub",
    "andrew-ng"
  ],
  "bin": {
    "autochub": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:cli",
    "build:cli": "tsc -p tsconfig.cli.json",
    "watch": "tsc -w -p tsconfig.cli.json",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "lint": "tsc --noEmit -p tsconfig.cli.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aisuite/chub": "^0.1.3",
    "commander": "^11.0.0",
    "dotenv": "^17.2.3",
    "graphology": "^0.25.4",
    "graphology-shortest-path": "^2.1.0",
    "graphology-traversal": "^0.3.1",
    "typescript": "~5.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
