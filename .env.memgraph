# Memgraph Configuration for Auto-CHUB
# These settings are used by the Memgraph service

MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_USERNAME=memgraph
MEMGRAPH_PASSWORD=memgraph

# Optional: Uncomment to use remote Memgraph instance
# MEMGRAPH_HOST=your-memgraph-cloud.memgraph.io
# MEMGRAPH_PORT=7687
# MEMGRAPH_USERNAME=your-username
# MEMGRAPH_PASSWORD=your-password
